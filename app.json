{
  "expo": {
    "name": "Bora de quê?",
    "slug": "bora-de-que",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-font",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Permita que o Bora de quê? fotografe suas atividades realizadas.",
          "microphonePermission": false,
          "photosPermission": false
        }
      ],
      "expo-status-bar"
    ]
  }
}
